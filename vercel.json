{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "echo 'No runtime dependencies — the build tooling (journal/wallpapers/essays) runs locally, not on Vercel.'",
  "buildCommand": "echo 'Static site — nothing to build; serving the committed HTML/CSS/JS as-is.'",
  "outputDirectory": ".",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/((?!admin).*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self' https://vtbvhhilucxroqoaohjb.supabase.co; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self' mailto:; frame-ancestors 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-5qId0/HhhFl16ZQ6od65Kcmis8R6d74pgT1Z/EwiARw=' 'sha256-v2dCrnQiz+wc221Fx+CFHJr+N3g2Ea0l49fhORyU9Y8='; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://vtbvhhilucxroqoaohjb.supabase.co; font-src 'self'; connect-src 'self' https://vtbvhhilucxroqoaohjb.supabase.co wss://vtbvhhilucxroqoaohjb.supabase.co; frame-src 'self'; object-src blob:; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/i18n/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(styles\\.css|app\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/quote",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "(?i)^nl.*"
        }
      ],
      "destination": "/nl/websites/#quote",
      "permanent": false
    },
    {
      "source": "/quote",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "(?i)^de.*"
        }
      ],
      "destination": "/de/websites/#quote",
      "permanent": false
    },
    {
      "source": "/quote",
      "destination": "/websites/#quote",
      "permanent": false
    },
    {
      "source": "/offerte",
      "destination": "/nl/websites/#quote",
      "permanent": false
    },
    {
      "source": "/angebot",
      "destination": "/de/websites/#quote",
      "permanent": false
    }
  ]
}
